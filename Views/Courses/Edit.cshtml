@model Models.Course

@{
    ViewBag.Title = "Edit";
}



@using (Html.BeginForm())
{

    @Html.AntiForgeryToken() <!-- Injection de jeton anti contrefaçon de formulaire -->
    <details id="courseInfo" open>
        <summary>Informations - [@Model.Code]</summary>
        <fieldset>
            <legend>Session</legend>
            <input id="Session"
                   name="Session"
                   class="form-control"
                   type="number"
                   min="1"
                   max="6"
                   placeholder="Session entre 1 et 6"
                   required
                   value="@Model.Session"
                   RequireMessage="Veuillez entrer une Session entre 1 et 6" />
        </fieldset>

        <fieldset>
            <legend>Sigle</legend>
            <input class="form-control"
                   name="Code"
                   id="Code"
                   placeholder="Code"
                   style="margin-bottom:8px;"
                   required
                   value="@Model.Code"
                   RequireMessage="Veuillez entrer un code" />
        </fieldset>

        <fieldset>
            <legend>Titre du cours</legend>
            <input class="form-control"
                   name="Title"
                   id="Title"
                   placeholder="Titre du cours"
                   style="margin-bottom:8px;"
                   required
                   value="@Model.Title"
                   RequireMessage="Veuillez entrer un titre" />
        </fieldset>
    </details>

    <details id="studentIsncriptions">
        <summary>Inscriptions @Models.NextSession.ShortCaption</summary>
        @Helper.SelectionLists("selectedStudentsId", (SelectList)ViewBag.Registrations, (SelectList)ViewBag.Students)
    </details>

    <input id="submit" type="submit" value="Enregistrer" class="btn btn-primary" style="display:none">
}

