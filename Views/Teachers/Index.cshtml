
@{
    ViewBag.Title = "Index";
}

<div id="TeacherListPanel">

</div>
@section Scripts {
    <script>

        let listAutoRefreshPanel =
            new AutoRefreshedPanel(
                "TeacherListPanel",
                "/Teachers/GetTeachers",
                10,
                teachersListPostRefresh);

        function teachersListPostRefresh() {
            let search = "@Session["SearchString"]";
            if (search != "") {
                $(".teacherName ").each(function () {
                    let text = $(this).html();
                    let highlighted = text.replace(new RegExp(search, "gi"), match => `<mark>${match}</mark>`);
                    $(this).html(highlighted);
                });
            }
        }
    </script>
}
